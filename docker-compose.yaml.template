services:
  memgraph:
    image: memgraph/memgraph-mage
    ports:
      - "${MEMGRAPH_PORT:-7687}:7687"
      - "${MEMGRAPH_HTTP_PORT:-7444}:7444"
    volumes:
      - "./export:/export"
  lab:
    image: memgraph/lab
    ports:
      - "${LAB_PORT:-3000}:3000"
    environment:
      QUICK_CONNECT_MG_HOST: memgraph
  cgr:
    image: cgr:${TAG:-dev}
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - "./export:/cgr/export"
      - ".:/local_disk"
    stdin_open: true
    tty: true
    depends_on:
      - memgraph
      - lab
    env_file:
      - .env
    environment:
      - PATH=/benchmark/defects4j/framework/bin/defects4j:$PATH